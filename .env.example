# ===== Production server (Nitro — same process as the website) =====
# Set these on the host / in your deploy platform before `npm run build && npm run preview`
CRM_API_URL=https://www.zohoapis.in/crm/v7/functions/add_website_lead/actions/execute?auth_type=apikey&zapikey=YOUR_KEY
CRM_DEBUG=false

# Only if the API runs on a different domain than the site (usually leave unset)
# VITE_API_BASE_URL=https://wellspringsacademy.in

# ===== Local dev — optional standalone Express backend (npm run dev:backend) =====
# See backend/.env.example for PORT, FRONTEND_ORIGIN, CRM_API_URL
